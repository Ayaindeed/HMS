<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="hospital-pu" transaction-type="RESOURCE_LOCAL">
        <description>Hospital Management System Persistence Unit</description>
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entity Classes -->
        <class>org.hsc.hospital_management_system.entity.Patient</class>
        <class>org.hsc.hospital_management_system.entity.Medecin</class>
        <class>org.hsc.hospital_management_system.entity.RendezVous</class>
        <class>org.hsc.hospital_management_system.entity.ServiceHospitalier</class>
        <class>org.hsc.hospital_management_system.entity.DossierMedical</class>

        <properties>
            <!-- PostgreSQL Connection Settings - overridden by JpaConfig -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/hospital_db"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="postgres"/>

            <!-- Hibernate Configuration -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.use_sql_comments" value="true"/>
            <property name="hibernate.jdbc.batch_size" value="20"/>
            <property name="hibernate.order_inserts" value="true"/>
            <property name="hibernate.order_updates" value="true"/>

            <!-- Connection Pool Settings -->
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.hikari.minimumIdle" value="5"/>
            <property name="hibernate.hikari.idleTimeout" value="300000"/>
            <property name="hibernate.hikari.maxLifetime" value="1200000"/>
            <property name="hibernate.hikari.connectionTimeout" value="30000"/>

            <!-- Query Hints -->
            <property name="hibernate.query.in_clause_parameter_padding" value="true"/>

            <!-- Logging -->
            <property name="hibernate.generate_statistics" value="false"/>
        </properties>
    </persistence-unit>

</persistence>
